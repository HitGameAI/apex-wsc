#!/usr/bin/env bash
set -euo pipefail

# Go passes the test binary and its arguments to this wrapper.
# Only set up the network as root, then run the binary as the runner user.
exec sudo -n /usr/bin/unshare --net -- /bin/bash -euo pipefail -c '
  /usr/sbin/ip link set dev lo up
  exec /usr/bin/setpriv --reuid="$1" --regid="$2" --clear-groups --no-new-privs --bounding-set=-all -- "${@:3}"
' loopback-test "$(id -u)" "$(id -g)" "$@"
